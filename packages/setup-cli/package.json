{
  "name": "@nexus/cli",
  "version": "0.10.0",
  "description": "Nexus CLI for using Fireworks models in AI coding tools",
  "type": "module",
  "bin": {
    "nexus": "./bin/nexus.mjs"
  },
  "files": [
    "bin",
    "lib"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
