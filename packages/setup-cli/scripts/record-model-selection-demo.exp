#!/usr/bin/expect -f
# Record the interactive model picker for `nexus demo` (quit before the race).
set timeout 120

set env(HOME) /tmp/fc-demo-rec-home
set env(NEXUS_KEY_STORAGE) file
set env(KEYRING_FILE_MASTER_KEY) 0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
set env(COLUMNS) 100
set env(LINES) 40
set env(TERM) xterm-256color

cd /agent/repos/fireconnect-internal/packages/setup-cli

spawn -noecho bash -c {stty cols 100 rows 40 2>/dev/null; exec node bin/nexus.mjs demo --no-open --out /tmp/fc-model-select-out}

expect {
  -re {Nexus Demo.{0,3}setup} {}
  timeout {
    puts "timeout waiting for setup form"
    exit 1
  }
}

sleep 2.0
# Browse left model catalog
send "\033\[C"
sleep 0.9
send "\033\[C"
sleep 0.9
send "\033\[C"
sleep 0.9
# Move to right model (editable — no --right-model CLI flag)
send "\033\[B"
sleep 0.9
send "\033\[C"
sleep 0.9
send "\033\[C"
sleep 0.9
send "\033\[C"
sleep 0.9
send "\033\[C"
sleep 0.9
send "\033\[B"
sleep 0.9
send "\033\[A"
sleep 1.0
# Quit — do not start the billed race
send "q"
expect {
  -re {Demo cancelled|Error: Demo cancelled} { }
  eof { }
}

sleep 0.3
exit 0
